# Runtime: defaults to loading `.env`. Use another file: DJANGO_DOTENV_FILE=.env.dev uv run python manage.py …
DEBUG=1
SECRET_KEY=replace-with-long-random-secret
DJANGO_ALLOWED_HOSTS="localhost 127.0.0.1"
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=pet_shelter_db
SQL_USER=postgres
SQL_PASSWORD=replace-with-dev-db-password
SQL_HOST=db
SQL_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-dev-db-password
POSTGRES_DB=pet_shelter_db

# Email (optional). Defaults: file backend writes under ./emails; from-address for real SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL="Pet Shelter <noreply@example.com>"
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
